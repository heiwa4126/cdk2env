{
	"name": "@heiwa4126/cdk2env",
	"version": "0.0.5",
	"description": "Convert AWS CDK outputs.json to shell-sourceable export file. CLI tool and library with dual ESM/CJS support.",
	"keywords": [
		"aws-cdk",
		"bash",
		"cdk",
		"cli",
		"commonjs",
		"environment-variables",
		"esm",
		"export",
		"outputs",
		"shell",
		"typescript"
	],
	"homepage": "https://github.com/heiwa4126/cdk2env#readme",
	"bugs": {
		"url": "https://github.com/heiwa4126/cdk2env/issues"
	},
	"license": "MIT",
	"author": "heiwa4126 <heiwa4126@gmail.com>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/heiwa4126/cdk2env.git"
	},
	"bin": {
		"cdk2env": "dist/main.js"
	},
	"files": [
		"dist/**/*.js",
		"dist/**/*.cjs",
		"dist/**/*.d.ts",
		"!dist/**/*.map"
	],
	"type": "module",
	"main": "./dist/index.cjs",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		}
	},
	"scripts": {
		"build": "tsdown",
		"test": "vitest run",
		"test:run": "vitest run",
		"test:watch": "vitest",
		"clean": "rm -rf dist",
		"prepublishOnly": "run-s lint test clean build smoke-test",
		"preinstall": "pnpm audit",
		"format": "oxfmt",
		"lint": "oxlint",
		"check": "oxfmt && oxlint --fix",
		"format:all": "pnpm pkg fix --loglevel=error && oxlint",
		"smoke-test": "node examples/ex1.mjs && node examples/ex2.cjs && tsx examples/ex3.ts && node dist/main.js test/fixtures/sample1.json test/temp/smoke.sh",
		"retag": "bash scripts/retag.sh",
		"prepack": "clean-publish-scripts -c",
		"postpack": "clean-publish-scripts -r",
		"osv-scan": "osv-scanner .",
		"g": "run-s prepublishOnly format:all osv-scan"
	},
	"devDependencies": {
		"@heiwa4126/clean-publish-scripts": "^0.0.6",
		"@types/node": "^26.1.0",
		"npm-run-all2": "^9.0.2",
		"oxfmt": "^0.57.0",
		"oxlint": "^1.72.0",
		"tsdown": "^0.22.3",
		"tsup": "^8.5.1",
		"tsx": "^4.23.0",
		"typescript": "^6.0.3",
		"vitest": "^4.1.9"
	},
	"engines": {
		"node": ">=18.0.0"
	}
}
